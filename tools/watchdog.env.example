# AgentKeyGuard 监控配置模板
# 用法：cp watchdog.env.example watchdog.env，填入自己的值；cron 里 source 它
# ⚠️ 必须 export：. file 只会设 shell 变量，不 export 的话 python3 子进程看不到
#    （实测踩过：不 export 时脚本一直用默认 /var/tmp 路径，普通用户还没写权限）

# Bark 地址（https://api.day.app/<你的key>）。留空则只写日志不推送
export VB_WD_BARK=

# 公网探测地址：经反代 + TLS。自签证书，脚本内已忽略校验
export VB_WD_URL=https://vault.example.local/health

# 直连地址：诊断分流用（反代挂了 vs Broker 本身挂了）。留空则不做分流
export VB_WD_DIRECT=http://192.0.2.10:7700/health

# 连续失败几次才报警（默认 3 = 3 分钟）
export VB_WD_FAILS=3

# 状态与日志（改成你有写权限的目录）
export VB_WD_STATE=/var/tmp/vb_watchdog.state.json
export VB_WD_LOG=/var/tmp/vb_watchdog.log

# DNS 抽风时才需要：强制把域名解析到 Broker 所在机
# export VB_WD_RESOLVE=vault.example.local:443:192.0.2.10
