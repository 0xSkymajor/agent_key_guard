# AgentKeyGuard systemd 环境文件（模板）
#
# 安装后由 postinst 生成 /etc/agentkeyguard/agentkeyguard.env（0600 root:root）。
# Web 初始化完成后，主密码由 /setup 写入 /var/lib/agentkeyguard/master.key，
# 这里不再需要填 AGENTKEYGUARD_MASTER_PASS。
AGENTKEYGUARD_PORT=7700

# Bark 推送（手机审批；留空则回落到服务器终端 y/N）
# AGENTKEYGUARD_BARK=https://api.day.app/YOUR_KEY

# 对外可达地址（Bark 通知里点开的就是这里）
# AGENTKEYGUARD_PUBLIC_BASE=https://192.0.2.11:7700

# 审批超时（秒）
# AGENTKEYGUARD_APPROVAL_TIMEOUT=300
